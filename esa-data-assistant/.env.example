# Configuration ESA Data Assistant
# Copiez ce fichier en .env et remplissez vos valeurs

# Clé API Mistral (La Plateforme)
# Obtenez-la sur https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Configuration optionnelle
LOG_LEVEL=INFO
CHROMA_PERSIST_DIR=./data/chroma
ESA_CATALOG_URL=https://eocat.esa.int/eo-catalogue/
